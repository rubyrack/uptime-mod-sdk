# The #news posts of this pack's two macro events. The pack id
# com.uptime.example-events gives the prefix mod-com-uptime-example--events-.

mod-com-uptime-example--events-heatwave_start = A heatwave is pushing the grid hard. Power costs more until it breaks.
    .eng = Heatwave: grid at peak load, utility power prices up. Watch PSU wear.
mod-com-uptime-example--events-heatwave_end = The heatwave is over. Power prices are back to normal.
mod-com-uptime-example--events-recall_start = A memory maker recalled a batch of chips. Storage-heavy servers cost more and ship late.
    .eng = DRAM and NAND recall: storage SKU capex up, lead times doubled.
mod-com-uptime-example--events-recall_end = The chip recall is over. Server prices and delivery times are back to normal.
