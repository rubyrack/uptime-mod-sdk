# The mod manifest ledger, from `RawManifest`'s serde and `sim_mods::MANIFEST_FIELDS`: a
# mod writes, the host reads. `optional` = a manifest may omit it; `(lo..hi)` is the
# accepted size (entries of a list, bytes of the file or a string).
# Generated by `make mod-schema`, shipped by `make mod-api-ship`, never edited by hand.
# generation v1alpha1, minor 0, shipped true
Grammar.modid string(1..128) required @0
Grammar.path string(1..240) required @0
Grammar.semver string required @0
Grammar.semver-req string required @0
Manifest {..}(0..65536) required @0
Manifest.affects_gameplay bool required @0
Manifest.api_minor uint32 optional @0
Manifest.api_version enum required @0
Manifest.api_version=v1alpha1 value required @0
Manifest.commands [enum] optional @0
Manifest.commands=customers value required @0
Manifest.commands=finance value required @0
Manifest.commands=incidents value required @0
Manifest.commands=infrastructure value required @0
Manifest.config_schema path optional @0
Manifest.content [enum] optional @0
Manifest.content=art value required @0
Manifest.content=customers value required @0
Manifest.content=events value required @0
Manifest.content=hardware value required @0
Manifest.content=locale value required @0
Manifest.content=scenarios value required @0
Manifest.content=services value required @0
Manifest.dependencies {semver-req}(0..64) optional @0
Manifest.events [enum] optional @0
Manifest.events=builds value required @0
Manifest.events=customers value required @0
Manifest.events=finance value required @0
Manifest.events=incidents value required @0
Manifest.events=lifecycle value required @0
Manifest.events=receipts value required @0
Manifest.game_version semver-req required @0
Manifest.id modid required @0
Manifest.kind [enum] required @0
Manifest.kind=content value required @0
Manifest.kind=script value required @0
Manifest.manifest_version uint64 required @0
Manifest.panels [path](0..32) optional @0
Manifest.reads [string](0..64) optional @0
Manifest.script {..} optional @0
Manifest.script.entry path required @0
Manifest.script.runtime enum required @0
Manifest.script.runtime=component value required @0
Manifest.script.runtime=lua value required @0
Manifest.state_schema uint32 optional @0
Manifest.version semver required @0
